# ══════════════════ MediAgent 配置示例 ══════════════════
# 复制为 .env 即可覆盖默认配置

# ── 模型：默认 local（私有化部署的内置推理引擎，零依赖离线可跑）──
# 想接云端大模型，改成 deepseek 并填好 Key 即可，业务代码零改动
LLM_PROVIDER=local
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0

# ── 检索：默认本地轻量实现；装好 sentence-transformers 后可切到真模型 ──
EMBEDDING_PROVIDER=local
RERANK_PROVIDER=local
RETRIEVAL_TOP_N=20
RETRIEVAL_TOP_K=5
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3

# ── 置信度门控（医疗场景：宁可拒答，不可幻觉）──
CONFIDENCE_GENERATE=0.62
CONFIDENCE_REFUSE=0.42
MIN_DOCS=2

# ── 工具层 ──
MCP_TRANSPORT=inproc

# ── 数据层：留空使用内置轻量索引；配了 Milvus 地址即切到 Milvus 2.4 ──
MILVUS_URI=
MILVUS_COLLECTION=medical_kb

# ── 服务 ──
HOST=127.0.0.1
PORT=8000
DEBUG=true
